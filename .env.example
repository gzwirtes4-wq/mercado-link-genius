# Modelo de variáveis de ambiente. NÃO coloque valores reais aqui.
# Detalhes de cada integração: CONFIGURACAO_APIS.md
#
# VITE_*  → vão para o NAVEGADOR (públicas). Definidas no momento do build.
# demais  → só SERVIDOR (secrets do Worker / Lovable Cloud). Nunca use VITE_ em segredo.
# Local: copie para .env.local (ignorado pelo git) ou .dev.vars (wrangler).

# ── Supabase (obrigatório) ────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<projeto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable/anon key, é pública>
VITE_SUPABASE_PROJECT_ID=<id do projeto>
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<mesma publishable key>
SUPABASE_SERVICE_ROLE_KEY=<SECRETA: ignora RLS, só servidor>

# ── Mercado Livre (OAuth no servidor) ────────────────────────────────────────
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://<seu-dominio>/api/meli/callback

# ── Pagamento (links públicos de checkout, usados nos botões de plano) ───────
VITE_CHECKOUT_URL_MONTHLY=
VITE_CHECKOUT_URL_LIFETIME=

# ── Login com Google ─────────────────────────────────────────────────────────
# false/vazio = via Lovable Cloud (atual). true = provedor Google do seu Supabase.
VITE_GOOGLE_AUTH_VIA_SUPABASE=

# ── Reservado: ainda NÃO usado pelo código (integrações pendentes) ───────────
# APPLYFY_WEBHOOK_SECRET=     # webhook de pagamento (aguarda documentação oficial)
# CJ_API_KEY=                 # CJdropshipping (confirmar nomes na doc oficial)
# SHOPEE_AFFILIATE_APP_ID=    # Shopee Afiliados (confirmar na doc oficial)
# SHOPEE_AFFILIATE_SECRET=
# TOKEN_ENCRYPTION_KEY=       # criptografia de tokens em repouso (não implementada)
